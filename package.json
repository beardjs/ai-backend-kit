{
  "name": "@sauvvitech/st-cursor-backend",
  "version": "1.3.0",
  "description": "AI backend kit CLI for layered Node.js/TypeScript services \u2014 syncs .cursor / .claude / .codex tool kits plus shared docs into a service.",
  "author": {
    "name": "Filipe Paix\u00e3o",
    "url": "https://github.com/FilipePaixao"
  },
  "license": "UNLICENSED",
  "private": false,
  "bin": {
    "st-cursor-backend": "bin/st-cursor-backend.js"
  },
  "files": [
    "bin",
    "lib",
    ".cursor",
    ".claude",
    ".codex",
    ".agents",
    "AGENTS.md",
    "VERSION",
    "docs/architecture-and-layers.md",
    "docs/specs",
    "docs/templates",
    "examples/canonical-user",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SauvviTech/cursor-backend.git"
  },
  "keywords": [
    "cursor",
    "claude",
    "codex",
    "backend",
    "layered-architecture",
    "kit",
    "sauvvitech"
  ],
  "scripts": {
    "sync": "node bin/st-cursor-backend.js",
    "test": "node --test test/*.test.js",
    "check:version": "node scripts/check-version.js",
    "prepack": "node scripts/check-version.js"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0"
  }
}
