{
  "name": "@beardjs/ai-backend-kit",
  "version": "1.4.0",
  "description": "AI backend kit CLI for layered Node.js/TypeScript services — syncs .cursor / .claude / .codex tool kits plus shared docs into a service.",
  "author": {
    "name": "Filipe Paixão",
    "url": "https://github.com/FilipePaixao"
  },
  "license": "UNLICENSED",
  "private": false,
  "bin": {
    "ai-backend-kit": "bin/ai-backend-kit.js"
  },
  "files": [
    "bin",
    "lib",
    ".cursor",
    ".claude",
    ".codex",
    ".agents",
    "AGENTS.md",
    "VERSION",
    "docs/architecture-and-layers.md",
    "docs/specs",
    "docs/templates",
    "examples/canonical-user",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beardjs/ai-backend-kit.git"
  },
  "keywords": [
    "cursor",
    "claude",
    "codex",
    "backend",
    "layered-architecture",
    "kit",
    "beardjs"
  ],
  "scripts": {
    "sync": "node bin/ai-backend-kit.js",
    "test": "node --test test/*.test.js",
    "check:version": "node scripts/check-version.js",
    "prepack": "node scripts/check-version.js",
    "release": "semantic-release"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "semantic-release": "^24.2.7"
  }
}
